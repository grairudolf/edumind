# EduMind Backend Environment Variables

# Database
DATABASE_URL=postgresql://edumind:edumind@localhost:5432/edumind

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production-123456789
ACCESS_TOKEN_EXPIRE_MINUTES=30

# HuggingFace API
HUGGINGFACE_API_KEY=your-huggingface-api-key-here
MODEL_NAME=microsoft/DialoGPT-medium

# OpenAI API (fallback)
OPENAI_API_KEY=your-openai-api-key-here

# Speech Services
SPEECH_KEY=your-speech-service-key
SPEECH_REGION=eastus

# Translation API
TRANSLATION_API_KEY=your-translation-api-key

# Redis
REDIS_URL=redis://localhost:6379

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# File Upload Settings
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=mp3,wav,ogg,m4a

# Analytics
ENABLE_ANALYTICS=true
ANALYTICS_RETENTION_DAYS=365

# Offline Mode
ENABLE_OFFLINE_MODE=true
CACHE_TTL=3600

# Logging
LOG_LEVEL=INFO
